{
  "expo": {
    "name": "wiki-walker",
    "slug": "wiki-walker",
    "version": "1.0.2",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "backgroundColor": "#fffaf0"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "org.wikiwalker.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "wiki-walker nutzt deinen Standort, um Orte in deiner Nähe zu finden."
        }
      ]
    ],
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#7c8a64"
      },
      "package": "org.wikiwalker.app"
    }
  }
}
